  "narrative": {
    "northStar": "The Reverse Contact Sheet",
    "overview": "GlowDL 把下载任务当成一卷待归档的素材：暖黑的工作台、纸白的墨、1px 的刻度线、等宽的读数。界面像一张反面接触印相——暗底、白格、琥珀色的登记方块——而不是一张 SaaS 仪表盘。它借来视频素材管理的字体、配色、密度和一个标志性动作（时间码/清单读数），导航与控件仍保持桌面工具最熟悉的样子。",
    "keyCharacteristics": [
      "Zero radius on every surface, control and marker.",
      "Flat fills only: no gradient, shadow, blur or opacity animation.",
      "Paper-white is the only emphasis colour; green/amber/red are reserved for state.",
      "Hairline 1px rules and measured spacing carry hierarchy instead of elevation.",
      "Monospace is used only where a number is a measurement."
    ],
    "rules": [
      {
        "name": "The No-Elevation Rule",
        "body": "Never introduce a shadow, blur or glow. Separate layers with ground/surface value and 1px rules.",
        "section": "elevation"
      },
      {
        "name": "The State-Colour Rule",
        "body": "Green, amber and red may only encode done/progress/failure. Emphasis is paper white, never a second hue.",
        "section": "colors"
      },
      {
        "name": "The Measurement Rule",
        "body": "Monospace is reserved for timecode, byte counts, speed, percentages, versions and format ids. Prose never uses it.",
        "section": "typography"
      }
    ],
    "dos": [
      "Keep every panel and control square.",
      "Use tabular figures and ' · ' separators for running measurements.",
      "Elide long titles on one line and expose the full text in a tooltip.",
      "Keep the primary action paper-white and visible at 1080×700."
    ],
    "donts": [
      "Don't add rounded corners, gradients, shadows or glass.",
      "Don't use colour decoratively or as the only state signal.",
      "Don't nest cards or build the page from same-size icon/title/subtitle cards.",
      "Don't put a kicker above a heading, or use emoji as icons."
    ]
  }
}